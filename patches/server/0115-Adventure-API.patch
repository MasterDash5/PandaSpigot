@@ -0,0 +1,74 @@
+package com.hpfxd.pandaspigot.adventure;
+
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.serializer.gson.GsonComponentSerializer;
+import net.md_5.bungee.api.chat.BaseComponent;
+import net.minecraft.server.IChatBaseComponent;
+
+import java.util.ArrayList;
+import java.util.List;
+
+public class PandaAdventure {
+
+    public static final GsonComponentSerializer GSON = GsonComponentSerializer.builder()
+        .downsampleColors()
+        .legacyHoverEventSerializer(new NBTLegacyHoverEventSerializer())
+        .build();
+
+    private PandaAdventure() {}
+
+    public static Component asAdventure(IChatBaseComponent component) {
+        return GSON.serializer().fromJson(IChatBaseComponent.ChatSerializer.a(component), Component.class);
+    }
+
+    public static Component asAdventure(BaseComponent[] components) {
+        return GSON.serializer().fromJson(net.md_5.bungee.chat.ComponentSerializer.toString(components), Component.class);
+    }
+
+    public static List<Component> asAdventure(List<IChatBaseComponent> components) {
+        List<Component> list = new ArrayList<>(components.size());
+
+        for (IChatBaseComponent component : components) {
+            list.add(asAdventure(component));
+        }
+
+        return list;
+    }
+
+    public static List<Component> asAdventureFromJson(List<String> jsons) {
+        List<Component> list = new ArrayList<>(jsons.size());
+
+        for (String json : jsons) {
+            list.add(GSON.deserialize(json));
+        }
+
+        return list;
+    }
+
+    public static List<String> asJson(List<Component> components) {
+        List<String> list = new ArrayList<>();
+
+        for (Component component : components) {
+            list.add(GSON.serialize(component));
+        }
+
+        return list;
+    }
+
+    public static IChatBaseComponent asVanilla(Component component) {
+        return IChatBaseComponent.ChatSerializer.a(GSON.serializer().toJson(component));
+    }
+
+    public static List<IChatBaseComponent> asVanilla(List<Component> components) {
+        List<IChatBaseComponent> list = new ArrayList<>();
+
+        for (Component component : components) {
+            list.add(asVanilla(component));
+        }
+
+        return list;
+    }
+
+
+
+}
